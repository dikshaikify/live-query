{
  "name": "live-query-filter-system",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch backend/server.js",
    "dev:web": "npm run dev --prefix frontend",
    "build": "npm install --prefix frontend --include=dev && npm run build --prefix frontend",
    "start": "node backend/server.js",
    "test": "node --test backend/search.test.js"
  },
  "dependencies": { "cors": "^2.8.5", "express": "^4.19.2" },
  "devDependencies": { "concurrently": "^9.0.0" }
}
